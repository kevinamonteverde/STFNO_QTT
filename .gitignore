# Python virtual environments
/.venv
venv/
env/

# Project backups and data logs
/Data_Logs_Tests
/STFNO_QTT_backup

# Track specific scripts inside Data_Logs_Tests (data/outputs still excluded)
!Data_Logs_Tests/
!Data_Logs_Tests/conference_plots/
